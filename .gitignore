.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.env
.env.*

# Large raw downloads; re-fetch with `python -m scripts.build_vg_coco --stage sources`.
# MANIFEST.json (sha256 of each raw file) is committed so a rebuild can be verified.
data/raw/*
!data/raw/MANIFEST.json

# Intermediate build outputs; regenerate with scripts/build_vg_coco.py
data/interim/

# Final dataset (10k images) JSON is committed; the 1.4G image files are not (re-download via scripts).
data/processed/vg_coco/images/

# EDA review byproducts (regenerate with scripts/review_vg_coco.py + archify).
# Only files referenced by reports/data-review/{index,sample}.html are committed.
reports/data-review/stats.json
reports/data-review/diagrams/*.visual-check.*
reports/data-review/diagrams/*.workflow.json
reports/data-review/diagrams/*.dataflow.json
reports/data-review/figures/*
!reports/data-review/figures/objects_n.png
!reports/data-review/figures/relations_n.png

# Local explainer page (not part of the deliverable).
docs/explainer/

# Local build/EDA scripts and diagram pages (not shipped).
scripts/build_vg_coco.py
scripts/build_vn_heritage.py
scripts/review_vg_coco.py
reports/data-review/diagrams/

# CLIP embeddings (about 130 MB); regenerate with `python -m scripts.embed_vg_coco`.
data/processed/vg_coco/embeddings/

# Training runs: checkpoints, exported graph vectors and W&B files are large or machine-local.
runs/graphsage/**/*.pt
runs/graphsage/**/graph_vectors.*
runs/graphsage/**/wandb/
runs/graphsage/**/train.log
wandb/
runs/graphsage/**/tracker_run_id.txt
runs/adamf_mat/**/*.pt
runs/adamf_mat/**/graph_vectors.*
runs/adamf_mat/**/wandb/
runs/adamf_mat/**/train.log
runs/adamf_mat/**/tracker_run_id.txt
runs/graphsage_label_text/**/*.pt
runs/graphsage_label_text/**/graph_vectors.*
runs/graphsage_label_text/**/wandb/
runs/graphsage_label_text/**/train.log
runs/graphsage_label_text/**/tracker_run_id.txt
# Training-queue console logs (progress bars); results live in each run's history.json.
runs/adamf_mat/*.log
# A worktree links the embeddings of the main checkout; the trailing-slash rule above misses a symlink.
data/processed/vg_coco/embeddings
