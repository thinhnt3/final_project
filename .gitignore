.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.env
.env.*

# Large raw downloads; re-fetch with `python -m scripts.build_vg_coco --stage sources`.
# MANIFEST.json (sha256 of each raw file) is committed so a rebuild can be verified.
data/raw/*
!data/raw/MANIFEST.json

# Intermediate build outputs; regenerate with scripts/build_vg_coco.py
data/interim/

# Final dataset (10k images) JSON is committed; the 1.4G image files are not (re-download via scripts).
data/processed/vg_coco/images/

# MKG-W: entity/triple/query JSON is committed; extracted images (about 6 GB) are not.
# Rebuild with `python -m scripts.build_mkg_w --stage all`.
data/processed/mkg_w/images/
data/processed/mkg_w/embeddings/
# MKG-W caption subset: JSON is committed; rebuild images with `python -m scripts.build_mkg_w_captions`.
data/processed/mkg_w_captions/images/
data/processed/mkg_w_captions/embeddings/

# EDA review byproducts (regenerate with scripts/review_vg_coco.py + archify).
# Only files referenced by reports/data-review/{index,sample}.html are committed.
reports/data-review/stats.json
reports/data-review/diagrams/*.visual-check.*
reports/data-review/diagrams/*.workflow.json
reports/data-review/diagrams/*.dataflow.json
reports/data-review/figures/*
!reports/data-review/figures/objects_n.png
!reports/data-review/figures/relations_n.png

# Local explainer page (not part of the deliverable).
docs/explainer/

# Local build/EDA scripts and diagram pages (not shipped).
scripts/build_vg_coco.py
scripts/build_vn_heritage.py
scripts/review_vg_coco.py
reports/data-review/diagrams/

# CLIP embeddings (about 130 MB); regenerate with `python -m scripts.embed_vg_coco`.
data/processed/vg_coco/embeddings/

# Training runs: checkpoints, exported graph vectors and W&B files are large or machine-local.
runs/graphsage/**/*.pt
runs/graphsage/**/graph_vectors.*
runs/graphsage/**/wandb/
runs/graphsage/**/train.log
wandb/
runs/graphsage/**/tracker_run_id.txt

# Generated experiment outputs stay local; reproduce them with scripts/.
# Historical files already tracked by Git are still tracked; runs/benchmark/ keeps the per-method summaries.
/runs/

# Derived data rebuilt by scripts: relation queries (build_relation_queries) and the WordNet IsA variant (build_kg_variant).
data/processed/vg_coco/relation_queries/
data/processed/vg_coco_kg/

# Private reports, local orchestration and verification logs.
/private/
# A worktree links the embeddings of the main checkout; the trailing-slash rule above misses a symlink.
data/processed/vg_coco/embeddings

# Full VG ∩ COCO variant: image files (~6 GB) are downloaded by build_vg_coco --stage images.
data/processed/vg_coco_full/images/
# Worktree links to the main checkout's interim build outputs.
data/interim
# Full variant outputs are large (scene_graphs.json ~270 MB); rebuild with scripts.make_full_split + build_vg_coco --stage export.
data/processed/vg_coco_full/
# KG variant: CLIP tables and copies of the base images/queries files are rebuilt by scripts.build_kg_variant.
data/processed/vg_coco_kg/embeddings/
data/processed/vg_coco_kg/images.json
data/processed/vg_coco_kg/queries.json

# Per-split CLIP embeddings; regenerate with scripts/run_vn_heritage_retrieval.py.
data/processed/*/retrieval/embeddings/
